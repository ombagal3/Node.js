{
  "name": "bulletproof-crm",
  "version": "2.0.0",
  "description": "Bulletproof Brands Enterprise CRM & Sales Automation with Google Sheets and MongoDB Atlas",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "kill-port": "powershell -Command \"Get-NetTCPConnection -LocalPort 3000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\"",
    "clean-data": "node clean_data.js"
  },
  "keywords": [
    "crm",
    "google-sheets",
    "mongodb-atlas",
    "sales-automation"
  ],
  "author": "Bulletproof Brands",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.12.0",
    "nodemailer": "^10.0.16"
  }
}
