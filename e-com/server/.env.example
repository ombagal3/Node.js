# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# You can provide a local MongoDB URI or MongoDB Atlas URI:
# e.g., mongodb://127.0.0.1:27017/ecommerce
# e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/ecommerce?retryWrites=true&w=majority
# If omitted or unavailable, the server automatically starts an in-memory MongoDB instance for development!
MONGODB_URI=

# Authentication Secret (Change in production!)
JWT_SECRET=super_secret_jwt_development_key_9384729183748291
JWT_EXPIRES_IN=7d

# Client URL (for CORS and credentials)
CLIENT_URL=http://localhost:5173

# Low Stock Alert Threshold
LOW_STOCK_THRESHOLD=5
